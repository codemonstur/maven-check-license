include https://raw.githubusercontent.com/codemonstur/bobfiles/master/foss-lib-github-maven

vendor: com.github.codemonstur
name: maven-check-license
version: 1.3.0
release: 17
description: A maven plugin for checking licenses of dependencies
license:
  name: MIT
developer:
  name: Jurgen Voorneveld
  email: jegvoorneveld@gmail.com
enablePreview: false
packaging: maven-plugin
dependencies:
  - repository: org.apache.maven:maven-core:3.10.0
    scope: provided
  - repository: org.apache.maven:maven-plugin-api:3.10.0
    scope: provided
  - repository: org.apache.maven.plugin-tools:maven-plugin-annotations:3.16.0
    scope: provided
  - repository: org.apache.maven:maven-project:3.0-alpha-2
    scope: provided
  - repository: org.junit.jupiter:junit-jupiter:6.1.3
    scope: test

build
 |  mvn clean package -DskipTests

update
 |  mvn validate -P vulnerabilities
 |  mvn validate -P licenses
